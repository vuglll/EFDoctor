<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Nemanja Markovic</Authors>
    <!-- The repository URL. When set, the tool package links to it and carries Source Link;
         empty keeps URLs out of the package. -->
    <EFDoctorRepositoryUrl>https://github.com/vuglll/EFDoctor</EFDoctorRepositoryUrl>
    <Copyright>Copyright 2026 Nemanja Markovic</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- One version and one set of release notes for both packages: the EFDoctor tool and
       EFDoctor.Analyzers. -->
  <PropertyGroup Label="Release">
    <Version>0.5.0</Version>
    <PackageReleaseNotes>0.5.0: two new rules, for 26 in all. EFD028 reports a method of the application inside a query filter or ordering, which EF Core cannot translate, and EFD030 reports a query returned after its DbContext is disposed. Rules that need only a query's origin now follow query locals composed in branches, every rule now understands DbSet.AsQueryable(), and EFD012 covers SqlQueryRaw. See CHANGELOG.md in the package.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
