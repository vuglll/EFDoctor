<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Nemanja Markovic</Authors>
    <!-- The repository URL. When set, the tool package links to it and carries Source Link;
         empty keeps URLs out of the package. -->
    <EFDoctorRepositoryUrl>https://github.com/vuglll/EFDoctor</EFDoctorRepositoryUrl>
    <Copyright>Copyright 2026 Nemanja Markovic</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- One version and one set of release notes for both packages: the EFDoctor tool and
       EFDoctor.Analyzers. -->
  <PropertyGroup Label="Release">
    <Version>0.6.0</Version>
    <PackageReleaseNotes>0.6.0: ten new rules, for 36 in all, among them EFD031 (LINQ over a stored-procedure call), EFD032 (change to an AsNoTracking entity that is never saved), EFD033 (DbContext captured by a singleton), EFD034 (EnsureCreated with migrations), and EFD035 and EFD036, which read the model snapshot. The first code fixes ship in the analyzers package, for EFD002, EFD010, EFD019, and EFD029. EFD006 now honors a split-query default, and test-project detection no longer skips projects that only reference an assertion library. See CHANGELOG.md in the package.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
