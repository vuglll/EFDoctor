<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Nemanja Markovic</Authors>
    <!-- The repository URL. When set, the tool package links to it and carries Source Link;
         empty keeps URLs out of the package. -->
    <EFDoctorRepositoryUrl>https://github.com/vuglll/EFDoctor</EFDoctorRepositoryUrl>
    <Copyright>Copyright 2026 Nemanja Markovic</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- One version and one set of release notes for both packages: the EFDoctor tool and
       EFDoctor.Analyzers. -->
  <PropertyGroup Label="Release">
    <Version>0.4.0</Version>
    <PackageReleaseNotes>0.4.0: the rules now also ship as the EFDoctor.Analyzers package, which runs them in every build and in the IDE. Two new rules, for 24 in all: EFD037 reports entities loaded when only a few columns are read, and EFD038 reports ExecuteUpdate or ExecuteDelete that leaves tracked entities stale. EFD002 and EFD019 now follow a result stored in a local, and EFD002 is renamed. See CHANGELOG.md in the package.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
