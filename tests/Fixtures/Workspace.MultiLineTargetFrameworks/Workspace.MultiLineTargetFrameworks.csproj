<Project Sdk="Microsoft.NET.Sdk">
  <!-- Two frameworks separated by line breaks, with a trailing ';'. EF Core 10 targets only net10.0,
       so the net8.0 build compiles no EF code. -->
  <PropertyGroup>
    <TargetFrameworks>
      net10.0;
      net8.0;
    </TargetFrameworks>
    <OutputType>Library</OutputType>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);EFD001</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="Cases.cs" />
  </ItemGroup>
</Project>
