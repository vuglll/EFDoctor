<Project Sdk="Microsoft.NET.Sdk">
  <!-- An entity-model project, as Kavita's Kavita.Models is: it references only the EF Core
       abstractions for mapping attributes, and declares no DbContext. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" />
  </ItemGroup>
</Project>
