<Project Sdk="Microsoft.NET.Sdk">
  <!-- The data project of a split-query solution, as ErsatzTV's is: it queries the context, and the
       host project configures split queries by default. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);EFD006</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>
</Project>
